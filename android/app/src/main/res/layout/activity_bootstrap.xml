<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/bootstrap_heading" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/bootstrap_heading"
            android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_primary"
            android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/bootstrap_intro"
            android:textColor="@color/text_secondary" android:textSize="16sp" />
        <TextView android:id="@+id/bootstrap_planner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textColor="@color/text_primary" android:textSize="16sp" />
        <Button android:id="@+id/bootstrap_demo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bootstrap_demo" android:textAllCaps="false" />
        <Button android:id="@+id/bootstrap_configure_planner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bootstrap_configure_planner" android:textAllCaps="false" />
        <Button android:id="@+id/bootstrap_download_qwen" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bootstrap_download_qwen" android:textAllCaps="false" />
        <TextView android:id="@+id/bootstrap_download_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/bootstrap_download_metadata"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:autoLink="web" android:linksClickable="true"
            android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/bootstrap_capabilities_heading"
            android:textColor="@color/text_primary" android:textSize="18sp"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/bootstrap_capabilities" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary" android:textSize="14sp"
            android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/bootstrap_microphone_explanation"
            android:textColor="@color/text_secondary" android:textSize="16sp" />
        <Button android:id="@+id/bootstrap_microphone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bootstrap_microphone" android:textAllCaps="false" />
        <TextView android:id="@+id/bootstrap_error" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/bootstrap_error"
            android:textColor="@color/text_primary" android:visibility="gone"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/bootstrap_progress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/bootstrap_saving"
            android:textColor="@color/text_secondary" android:visibility="gone"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/bootstrap_finish" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="16dp" android:text="@string/bootstrap_finish"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
